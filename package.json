{
  "name": "workgate",
  "version": "0.1.5",
  "description": "File-backed work item tracker that gates AI-assisted changes behind claimed items, worktrees and a verified merge flow.",
  "type": "module",
  "bin": {
    "wg": "bin/wg",
    "workgate": "bin/wg"
  },
  "files": [
    "bin",
    "hooks",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexander-rebello/workgate.git"
  },
  "homepage": "https://github.com/alexander-rebello/workgate",
  "keywords": [
    "todo",
    "worktree",
    "workflow",
    "claude-code",
    "hooks"
  ]
}
